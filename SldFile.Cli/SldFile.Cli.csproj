<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AssemblyName>sldfile-cli</AssemblyName>
        <RootNamespace>SldFile.Cli</RootNamespace>
        <Description>Cross-platform headless CLI automation tool for parsing, querying, and exporting SolidWorks files (SLDPRT, SLDASM, SLDDRW) without SolidWorks installed.</Description>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>sldfile-cli</ToolCommandName>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\SldFile\SldFile.csproj" />
    </ItemGroup>

</Project>
